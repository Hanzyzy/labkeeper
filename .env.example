# LabKeeper — Environment Configuration
# Copy ke .env (jangan commit ke Git!)

# Flask secret key — GANTI dengan string random saat deploy!
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-random-string-32-karakter-di-sini

# URL base untuk QR codes (ganti saat deploy ke Railway)
BASE_URL=http://localhost:5000
